# ==============================================================================
# 3LITTLEBOSSES - MULTI-PLATFORM AUTO PUBLISHER CONFIGURATION
# ==============================================================================

# ── 1. Telegram Bot ───────────────────────────────────────────────────────────
# Tạo bot tại @BotFather để lấy token
TELEGRAM_BOT_TOKEN=

# --- Telegram Local Bot API Server (tải video tới 2GB, xem docker-compose.telegram.yml) ---
# Lấy api_id/api_hash tại https://my.telegram.org -> API development tools
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# Bỏ comment 3 dòng dưới sau khi server local đã chạy và bot đã logOut khỏi cloud
# TELEGRAM_API_BASE=http://localhost:8081
# TELEGRAM_LOCAL_CONTAINER_DIR=/var/lib/telegram-bot-api
# TELEGRAM_LOCAL_HOST_DIR=/Users/macbook_196/Workspace/something-dev/3littlebosses/storage/telegram-bot-api

# Chat ID được phép sử dụng bot (phân cách bằng dấu phẩy, để trống nếu cho phép tất cả)
ALLOWED_CHAT_IDS=
# Thời gian chờ gom album ảnh từ Telegram (ms)
PHOTO_BATCH_WINDOW_MS=4000

# ── 2. Media Server (Cung cấp Public URL cho Instagram & Threads) ──────────────
MEDIA_SERVER_PORT=3005
# URL công khai trỏ vào MEDIA_SERVER_PORT (VD: https://your-domain.com hoặc https://xxxx.ngrok-free.app)
# Meta yêu cầu URL có thể truy cập từ bên ngoài để kéo video/ảnh
PUBLIC_BASE_URL=http://localhost:3005

# ── 3. Facebook Fanpage (Reels & Photos) ──────────────────────────────────────
# Cấu hình Meta Graph API (Quyền: pages_show_list, pages_read_engagement, pages_manage_posts, publish_video)
ENABLE_FACEBOOK=true
FB_PAGE_ID=
FB_PAGE_ACCESS_TOKEN=
FB_API_VERSION=v21.0

# ── 4. Instagram (Reels & Feed/Carousel qua Meta Graph API) ────────────────────
# Dùng Meta Graph API qua Fanpage đã liên kết
ENABLE_INSTAGRAM=true
IG_USER_ID=
IG_ACCESS_TOKEN=



# ── 5. Threads ────────────────────────────────────────────────────────────────
# Tạo app tại Meta for Developers, cấp quyền threads_basic, threads_content_publish
ENABLE_THREADS=false
THREADS_USER_ID=
THREADS_ACCESS_TOKEN=

# ── 6. YouTube (Shorts & Video) ───────────────────────────────────────────────
# Google Cloud Console -> Bật YouTube Data API v3 -> Tạo OAuth 2.0 Credentials
ENABLE_YOUTUBE=false
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
# Trạng thái video mặc định: public, unlisted, private
YOUTUBE_PRIVACY_STATUS=public

# ── 7. TikTok (n8n Workflow riêng) ──────────────────────────────────────────
ENABLE_TIKTOK=true
# Webhook URL của workflow 3LittleBosses TikTok Publisher trên n8n
N8N_TIKTOK_WEBHOOK_URL=http://localhost:5678/webhook/3littlebosses-tiktok
# Credential ID lưu trong n8n
N8N_TIKTOK_CREDENTIAL_ID=cJDNuW2i1tFFXivi

# ── 8. X (Twitter) ────────────────────────────────────────────────────────────
ENABLE_TWITTER=false
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_SECRET=

# ── 9. Tuỳ chọn chung ─────────────────────────────────────────────────────────
# Tự động dọn dẹp file tạm sau khi đăng xong (true/false)
AUTO_CLEANUP_TEMP_FILES=true
# Dry-run: Giả lập quá trình đăng tải mà không thực sự gọi API (tiện kiểm tra luồng)
DRY_RUN=false
